{
  "$comment": "ytmGO design tokens: the single source of truth for the app and the website. See design/README.md. Colours with alpha are 8-digit hex. Sizes are CSS pixels (DIP in the app).",

  "color": {
    "dark": {
      "base": "#000000",
      "surface": "#121212",
      "raised": "#1f1f1f",
      "input": "#242424",
      "highlight": "#2a2a2a",
      "text": "#ffffff",
      "secondary": "#ffffffb3",
      "muted": "#ffffff8f",
      "accent": "#ff5a4f",
      "accentText": "#ff5a4f",
      "onAccent": "#000000",
      "attention": "#ffb35c",
      "line": "#ffffff1a",
      "hover": "#ffffff12",
      "press": "#ffffff1f",
      "track": "#ffffff4d",
      "scrim": "#00000099",
      "dim": "#ffffff57",
      "selection": "#ffffff33",
      "inverseHover": "#dbdbdb",
      "veil": "#00000099"
    },
    "light": {
      "base": "#e9e9eb",
      "surface": "#ffffff",
      "raised": "#f2f2f3",
      "input": "#ececee",
      "highlight": "#e1e1e4",
      "text": "#121212",
      "secondary": "#5a5a5f",
      "muted": "#6b6b70",
      "accent": "#e8382d",
      "accentText": "#b8261c",
      "onAccent": "#ffffff",
      "attention": "#8a5300",
      "line": "#0000001a",
      "hover": "#0000000d",
      "press": "#00000017",
      "track": "#00000036",
      "scrim": "#00000066",
      "dim": "#12121257",
      "selection": "#12121233",
      "inverseHover": "#303030",
      "veil": "#e9e9eb99"
    }
  },

  "tint": {
    "blue": "#2d46b9",
    "violet": "#8d67ab",
    "teal": "#1e7a6b",
    "rust": "#b0472b",
    "steel": "#477d95",
    "brown": "#7d4b32",
    "slate": "#5179a1",
    "raspberry": "#a13d63"
  },

  "font": {
    "$comment": "System fonts only: the platform's UI font for every text, display titles included, and its monospace.",
    "display": { "family": "system-ui", "weight": 800, "tracking": 0, "leading": 1.05, "leadingCJK": 1.18 },
    "mono": { "family": "ui-monospace" },
    "weight": { "regular": 400, "semibold": 600, "bold": 700, "heavy": 800 }
  },

  "size": {
    "micro": 12,
    "meta": 13,
    "small": 15,
    "body": 17,
    "lead": 19,
    "h3": 24,
    "h2": 32,
    "line": { "min": 22, "vw": 2.3, "max": 30 },
    "title": { "min": 32, "vw": 5.4, "max": 72 },
    "hero": { "min": 54, "vw": 9.2, "max": 136 }
  },
  "sizeCJK": {
    "title": { "min": 28, "vw": 3.9, "max": 54 },
    "hero": { "min": 40, "vw": 6.6, "max": 96 }
  },

  "radius": {
    "art": 8,
    "control": 12,
    "panel": 16,
    "sheet": 24,
    "pill": 999,
    "icon": "22%"
  },

  "space": [4, 8, 12, 16, 24, 32, 48, 72, 104, 144],

  "wash": { "dark": 0.5, "light": 0.32, "bar": 0.7, "cardDark": 0.28, "cardLight": 0.16,
    "brandTop": 0.7,
    "brandMid": 0.34 },

  "shadow": {
    "$comment": "Elevation: [offset y, blur, opacity of black] for the dark appearance; light uses lightScale of that opacity, since black on a light surface reads far heavier. Only artwork, floating panels, popovers, dialogs and floating play controls cast one.",
    "lightScale": 0.38,
    "tooltip": [2, 8, 0.25],
    "control": [8, 16, 0.3],
    "art": [8, 24, 0.3],
    "hero": [16, 48, 0.45],
    "popover": [12, 32, 0.35],
    "dialog": [24, 64, 0.5]
  },

  "motion": {
    "fast": 150,
    "base": 250,
    "slow": 700,
    "ease": "cubic-bezier(.2, .7, .2, 1)",
    "press": 0.96,
    "grow": 1.05
  },

  "product": {
    "frameGap": 8,
    "globalBar": 64,
    "player": 80,
    "miniPlayer": 60,
    "tabBar": 64,
    "library": 300,
    "rail": 72,
    "nowPlaying": 360,
    "row": 56,
    "libraryRow": 64,
    "tile": 64,
    "cardCover": 164,
    "collectionCover": 232,
    "playButton": 56,
    "chip": 32,
    "pill": 36,
    "target": 32,
    "targetTouch": 44
  },

  "brand": {
    "wrap": 1240,
    "wrapWide": 1320,
    "nav": 64,
    "section": 144,
    "block": 72,
    "gap": 24,
    "button": 48,
    "compact": { "section": 104, "block": 48, "body": 16, "lead": 17 }
  }
}
