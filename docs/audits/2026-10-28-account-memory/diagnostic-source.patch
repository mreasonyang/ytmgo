+}
+func (s *diagnosticMemorySecrets) Delete(key string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	value, ok := s.values[key]
+	if s.closed || !ok {
 		return accountbridge.ErrNotFound
 	}
-	return err
+	clear(value)
+	delete(s.values, key)
+	return nil
+}
+func (s *diagnosticMemorySecrets) Close() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.closed = true
+	for key, value := range s.values {
+		clear(value)
+		delete(s.values, key)
