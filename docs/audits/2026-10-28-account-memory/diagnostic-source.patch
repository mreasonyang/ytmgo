+// diagnosticMemorySecrets is confined to this isolated diagnostic build.
+// Every process starts empty. Values are copied into memory only, and cleared
+// on overwrite, deletion and close. No system secret API is called.
+type diagnosticMemorySecrets struct {
+	mu     sync.Mutex
+	values map[string][]byte
+	closed bool
+}
+
+func (s *diagnosticMemorySecrets) Set(key string, value []byte) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed {
+		return accountbridge.ErrStorage
+	}
+	if s.values == nil {
+		s.values = make(map[string][]byte)
+	}
+	clear(s.values[key])
+	s.values[key] = append([]byte(nil), value...)
+	return nil
+}
+func (s *diagnosticMemorySecrets) Get(key string) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	value, ok := s.values[key]
+	if s.closed || !ok {
 		return nil, accountbridge.ErrNotFound
 	}
-	return value, err
-}
