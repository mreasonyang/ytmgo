{
  "manifest_version": 3,
  "name": "ytmgo Account",
  "version": "1.0.0",
  "description": "Explicitly connect the selected YouTube Music account to the native ytmgo app.",
  "key": "",
  "permissions": [
    "cookies",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "http://127.0.0.1:52963/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ytmgo Account"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:52963"
  }
}
